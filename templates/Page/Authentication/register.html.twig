{% extends 'base.html.twig' %}

{% block title %}
    Register
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('static/css/authentication.css') }}">
{% endblock %}

{% block body %}
    <div id="authentication-container">
        <div id="app-title-container">
            <img src="{{ asset('static/svg/logo.svg') }}" alt="Logo">
            <span id="app-title">La Cave Donnarieix</span>
        </div>

        {{ form_start(form) }}
        <div id="credentials-container">
            {{ form_widget(form.email) }}
            {{ form_widget(form.username) }}
            {{ form_widget(form.password.first) }}
            {{ form_widget(form.password.second) }}
        </div>

        <div id="submits-container">
            <button>Sign Up</button>
            <span>Already have an account ? <a href="{{ path('app_login') }}">Sign In</a></span>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
