{% extends 'base.html.twig' %}

{% block title %}
    Profile
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('static/css/sidebar.css') }}">
    <link rel="stylesheet" href="{{ asset('static/css/profile.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('static/js/sidebar.js') }}"></script>
    <script src="{{ asset('static/js/profile.js') }}"></script>
{% endblock %}

{% block body %}
    {% include 'Widget/sidebar.html.twig' with {
        'pinned': pinned,
        'selected': 'settings',
        'storage': storage,
        'user': user
    } %}

    <main>
        <h1>Account settings</h1>

        <div>
            <input id="tab-profile" type="radio" name="tabs" checked>
            <input id="tab-security" type="radio" name="tabs">
            <input id="tab-admin" type="radio" name="tabs">
            <div id="sub-sidebar">
                <label id="for-tab-profile" for="tab-profile">
                    <img src="{{ asset('static/svg/user.svg') }}" alt="User">
                    <span>Profile</span>
                </label>
                <label id="for-tab-security" for="tab-security">
                    <img src="{{ asset('static/svg/security.svg') }}" alt="Security">
                    <span>Security</span>
                </label>
                <label id="for-tab-admin" for="tab-admin">
                    <img src="{{ asset('static/svg/admin.svg') }}" alt="Admin">
                    <span>Admin</span>
                </label>
            </div>

            <div id="main">
                <section id="profile-profile">
                    <div id="avatar-container">
                        <div id="avatar">
                            <div id="avatar-color"></div>

                            {% set name = user.displayName %}

                            {% if user.visibility == 0 %}
                                {# Firstname Lastname → JD #}
                                {% set parts = name|split(' ') %}
                                {% set initials = (parts[0]|slice(0, 1) ~ parts[1]|slice(0, 1)) %}
                            {% else %}
                                {# Username ou Email → 2 premières lettres #}
                                {% if '@' in name %}
                                    {% set name = name|split('@')[0] %}
                                {% endif %}
                                {% set initials = name|slice(0, 2) %}
                            {% endif %}

                            <span>{{ initials|upper }}</span>
                        </div>

                        <label for="avatar-file">Change picture</label>
                        <input type="file" id="avatar-file">

                        <button>Delete picture</button>
                    </div>

                    <div id="form">
                        <div id="name-information">
                            <div>
                                <label for="first-name">First name :</label>
                                <input id="first-name" type="text" placeholder="First name" value="{{ user.firstname }}">
                            </div>
                            <div>
                                <label for="last-name">Last name :</label>
                                <input id="last-name" type="text" placeholder="Last name" value="{{ user.lastname }}">
                            </div>
                        </div>
                        <div>
                            <label for="username">Username :</label>
                            <input id="username" type="text" placeholder="Username" value="{{ user.username }}">
                        </div>
                        <div>
                            <label for="input-email">Email :</label>
                            <input id="input-email" type="email" placeholder="Email" value="{{ user.email }}">
                        </div>
                        <div>
                            <div>
                                <label for="visibility">Visibility</label>
                                <select id="visibility">
                                    <option value="0" {{ user.visibility == 0 ? 'selected' : '' }}>Firstname Lastname</option>
                                    <option value="1" {{ user.visibility == 1 ? 'selected' : '' }}>Username</option>
                                    <option value="2" {{ user.visibility == 2 ? 'selected' : '' }}>Email</option>
                                </select>
                                <div id="select">
                                    <span id="select-choice"></span>
                                    <img src="{{ asset('static/svg/down.svg') }}" alt="Down">

                                    <div id="select-choices" class="hide"></div>
                                </div>
                            </div>
                            <button id="save-profile">Save profile</button>
                        </div>
                    </div>
                </section>

                <section id="profile-security">
                    <div id="inputs">
                        <div>
                            <label for="password">Password :</label>
                            <input id="password" type="password" placeholder="Password">
                        </div>
                        <div>
                            <label for="confirm-password">Confirm Password :</label>
                            <input id="confirm-password" type="password" placeholder="Confirm Password">
                        </div>
                    </div>
                    <div id="security-level">
                        <div id="security-progressbar">
                            <div id="lvl-0" class="lvl">
                                <div class="progressbar-background"><div class="progressbar-value"></div></div>
                            </div>
                            <div id="lvl-1" class="lvl">
                                <div class="progressbar-background"><div class="progressbar-value"></div></div>
                            </div>
                            <div id="lvl-2" class="lvl">
                                <div class="progressbar-background"><div class="progressbar-value"></div></div>
                            </div>
                            <div id="lvl-3" class="lvl">
                                <div class="progressbar-background"><div class="progressbar-value"></div></div>
                            </div>
                            <div id="lvl-4" class="lvl">
                                <div class="progressbar-background"><div class="progressbar-value"></div></div>
                            </div>
                        </div>
                        <span id="security-info">Strong password *</span>
                        <span id="security-tips">* Tips:</span>
                        <ul>
                            <li>special character</li>
                            <li>Uppercase</li>
                            <li>Lowercase</li>
                            <li>Digit</li>
                            <li>12 characters minimum</li>
                        </ul>
                    </div>
                    <span id="password-message">Passwords don't match !</span>
                    <button id="change-password">Change password</button>
                </section>

                <section id="admin-request">
                    <div id="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <td>Email</td>
                                    <td>Add storage</td>
                                    <td>Actions</td>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>lucien.donnarieix@gmail.com</td>
                                    <td>
                                        <input type="number">
                                        <select>
                                            <option>KB</option>
                                            <option>MB</option>
                                            <option>GB</option>
                                        </select>
                                    </td>
                                    <td class="actions">
                                        <div class="check">
                                            <img src="{{ asset('static/svg/check.svg') }}" alt="Check">
                                        </div>
                                        <div class="cancel">
                                            <img src="{{ asset('static/svg/close.svg') }}" alt="Close">
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </main>
{% endblock %}
