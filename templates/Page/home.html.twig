{% extends 'base.html.twig' %}

{% block title %}
    Home
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('static/css/home.css') }}">
    <link rel="stylesheet" href="{{ asset('static/css/sidebar.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('static/js/home.js') }}"></script>
    <script src="{{ asset('static/js/sidebar.js') }}"></script>
{% endblock %}

{% block body %}
    {% set selected = 'all_files' %}
    {% if root == 'favorites' %}
        {% set selected = 'favorites' %}
    {% endif %}
    {% include 'Widget/sidebar.html.twig' with {
        'pinned': pinned,
        'selected': selected,
        'storage': storage,
        'user': user
    } %}

    <input type="hidden" id="metadata-root" name="root" value="{{ root }}">

    <div id="overlay" class="hide"></div>
    <div id="create-folder" class="hide">
        <span>Create folder</span>
        <input type="text" placeholder="Folder name">
        <button id="create-folder-button">Create</button>
    </div>
    <div id="update-folder-menu" class="hide">
        <button id="pin">Pin</button>
        <button id="unpin">Unpin</button>
        <button id="mark-favorite">Mark as favorite</button>
        <button id="unmark-favorite">Unmark as favorite</button>
        <button id="rename">Rename</button>
        <button id="delete">Delete</button>
    </div>
    <div id="confirm-menu" class="hide">
        <span>Êtes vous sûr ?</span>
        <div>
            <button id="confirm-button">Oui</button>
            <button id="cancel-button">Non</button>
        </div>
    </div>
    <div id="rename-folder" class="hide">
        <span>Rename folder</span>
        <input type="text" placeholder="Folder name">
        <button id="rename-folder-button">Rename</button>
    </div>
    <div id="upload-file" class="hide">
        <span>Upload file</span>
        <input id="upload-file-input" type="file" class="hide">
        <button id="select-file-button">Select file</button>
        <input id="upload-file-name" type="text" placeholder="File name">
        <progress id="upload-progressbar" value="0" max="100" class="hide"></progress>
        <div id="upload-status" class="hide"></div>
        <button id="upload-file-button">Upload</button>
    </div>

    <main>
        <div id="header">
            <div id="searchbar">
                <label for="search">
                    <img src="{{ asset('static/svg/search.svg') }}" alt="Search">
                </label>
                <input id="search" type="text" placeholder="Search">
            </div>

            <button id="create">
                <img src="{{ asset('static/svg/add.svg') }}" alt="Add">
                <span>Create</span>
            </button>

            <button id="upload">
                <img src="{{ asset('static/svg/upload.svg') }}" alt="Upload">
                <span>Upload</span>
            </button>
        </div>

        <div id="sub-header">
            {# TODO: Completer le titre dynamiquement #}
            <span>La Cave de {{ user.displayName }}</span>

            <div id="display-modes">
                <div class="selected" id="grid-mode">
{#                    <img src="{{ asset('static/svg/grid.svg') }}" alt="Grid">#}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="4" y="4" width="6" height="6" rx="2" fill="currentColor" stroke="currentColor" stroke-width="2"></rect>
                        <rect x="14" y="4" width="6" height="6" rx="2" fill="currentColor" stroke="currentColor" stroke-width="2"></rect>
                        <rect x="4" y="14" width="6" height="6" rx="2" fill="currentColor" stroke="currentColor" stroke-width="2"></rect>
                        <rect x="14" y="14" width="6" height="6" rx="2" fill="currentColor" stroke="currentColor" stroke-width="2"></rect>
                    </svg>
                </div>
                <div id="list-mode">
{#                    <img src="{{ asset('static/svg/hamburger.svg') }}" alt="Burger">#}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 17H21M3 12H21M3 7H21" stroke="currentColor " stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div id="path-container">
            <span>
                <a href="{{ path('app_home') }}">root</a>
                <img src="{{ asset('static/svg/right.svg') }}" alt="Right">
                {% if path is defined %}
                    {% for item in path %}
                        <a href="{{ path('app_folder_uuid', {'uuid': item.uuid}) }}">{{ item.name }}</a>
                        <img src="{{ asset('static/svg/right.svg') }}" alt="Right">
                    {% endfor %}
                {% endif %}
            </span>
        </div>

        <div id="files" class="grid">
            <div id="file-template" class="file">
                <img src="{{ asset('static/svg/folder.svg') }}" alt="Folder" data-type="folder" class="hide">
                <img src="{{ asset('static/svg/archive.svg') }}" alt="Archive" data-type="archive" class="hide">
                <img src="{{ asset('static/svg/doc.svg') }}" alt="Doc" data-type="doc" class="hide">
                <img src="{{ asset('static/svg/font.svg') }}" alt="Font" data-type="font" class="hide">
                <img src="{{ asset('static/svg/image.svg') }}" alt="Image" data-type="image" class="hide">
                <img src="{{ asset('static/svg/audio.svg') }}" alt="Audio" data-type="audio" class="hide">
                <img src="{{ asset('static/svg/pdf.svg') }}" alt="PDF" data-type="pdf" class="hide">
                <img src="{{ asset('static/svg/sheets.svg') }}" alt="Sheets" data-type="sheets" class="hide">
                <img src="{{ asset('static/svg/slides.svg') }}" alt="Slides" data-type="slides" class="hide">
                <img src="{{ asset('static/svg/text.svg') }}" alt="Text" data-type="text" class="hide">
                <img src="{{ asset('static/svg/unknown.svg') }}" alt="Unknown" data-type="unknown" class="hide">
                <img src="{{ asset('static/svg/video.svg') }}" alt="Video" data-type="video" class="hide">
                <a href="">Folder 1</a>
                <img src="{{ asset('static/svg/menu.svg') }}" alt="Menu" class="menu">
            </div>
        </div>
    </main>

